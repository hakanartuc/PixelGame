#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 _entryPointOutput [[color(0)]];
};

struct main0_in
{
    float2 i_uv [[user(locn0)]];
    float4 i_col [[user(locn1)]];
};

fragment main0_out main0(main0_in in [[stage_in]], texture2d<float> Tex [[texture(0)]], sampler Smp [[sampler(0)]])
{
    main0_out out = {};
    out._entryPointOutput = Tex.sample(Smp, in.i_uv) * in.i_col;
    return out;
}

